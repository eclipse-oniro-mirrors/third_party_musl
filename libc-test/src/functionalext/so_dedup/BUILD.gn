import("../../../test_template.gni")
import("test_src_functionalext_so_dedup.gni")

# single source of truth for the on-device test sandbox: every path macro is
# derived from it so the fixtures created by the test and the DEDUP_ROOT
# overrides compiled into the implementation cannot drift
so_dedup_test_root = "/data/local/tmp/libc-test/so_dedup"

foreach(s, functionalext_so_dedup_list) {
  # not the standard test_unittest template: this test compiles the
  # implementation source together with the sandbox path overrides; the log
  # assertions exercise the real hilog path, so HiLogAdapterPrint and
  # musl_log_reset are pulled in from libc.a while the musl.log.* parameters
  # drive them (see main() of the test source)
  ohos_executable("${s}") {
    subsystem_name = "musl"
    part_name = "libc-test"
    testonly = true

    sources = [
      "${s}.c",
      "//third_party/musl/src/so_dedup/linux/so_dedup.c",
    ]

    include_dirs = [
      "../common",
      "//third_party/musl/libc-test/src/common",
      "//third_party/musl/libc-test/src/functionalext/common",
      "//third_party/musl/include/so_dedup",
      "//third_party/musl/src/internal",
      "//third_party/musl/src/internal/linux",
    ]

    defines = [
      "SO_DEDUP_TEST_ROOT=\"$so_dedup_test_root\"",
      "DEDUP_ROOT=\"$so_dedup_test_root\"",
      "_GNU_SOURCE",
      "OHOS_ENABLE_PARAMETER",
    ]

    configs = [ "//third_party/musl/libc-test/src/common:config_runtest" ]

    deps = [ "//third_party/musl:create_porting_src" ]

    external_deps = [
      "bounds_checking_function:libsec_shared",
      "init:parameterbase",
    ]

    if (!musl_unit_test_flag) {
      libs = [ "${musl_lib_dir}/libc.a" ]
    }
  }
}

group("functionalext_so_dedup_test") {
  testonly = true
  deps = []
  foreach(s, functionalext_so_dedup_list) {
    deps += [ ":${s}" ]
  }
}

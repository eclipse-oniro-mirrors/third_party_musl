import("../../../test_template.gni")

if (current_cpu == "arm64") {
  test_unittest("prelink_align_test") {
    target_dir = "functionalext/prelink"
  }

  # Carries a 2 MiB aligned PT_LOAD, so the loader selects KPMD_SIZE as the
  # mapping alignment when transparent hugepages are enabled.
  ohos_shared_library("prelink_align_huge") {
    testonly = true

    sources = [ "prelink_align_huge.c" ]

    output_name = "prelink_align_huge"
    output_extension = "so"

    cflags_c = [
      "-std=c99",
      "-fPIC",
    ]

    subsystem_name = "musl"
    part_name = "libc-test-lib"
  }

  ohos_shared_library("prelink_align_normal") {
    testonly = true

    sources = [ "prelink_align_normal.c" ]

    output_name = "prelink_align_normal"
    output_extension = "so"

    cflags_c = [
      "-std=c99",
      "-fPIC",
    ]

    subsystem_name = "musl"
    part_name = "libc-test-lib"
  }
}

group("functionalext_prelink_test") {
  testonly = true
  deps = []

  if (current_cpu == "arm64") {
    deps += [
      ":prelink_align_huge",
      ":prelink_align_normal",
      ":prelink_align_test",
    ]
  }
}

import("//build/test.gni")
import("../../../../test_template.gni")
import("../adlt_common.gni")

group("adlt_prelink_test") {
  testonly = true
  deps = [ ":unittest_adlt_prelink_dedup_symlinks" ]
}

# Merged adlt library made of two nDSOs sharing one file and one PT_GNU_RELRO.
adlt_shared_library("prelink_dedup") {
  lib_configs = [
    {
      name = "prelink_dedup_a"
      sources = [ "prelink_dedup_a.c" ]
    },
    {
      name = "prelink_dedup_b"
      sources = [ "prelink_dedup_b.c" ]
    },
  ]
}

# Must not link the libraries: they would already be loaded when record runs.
ohos_executable("unittest_adlt_prelink_dedup") {
  testonly = true
  subsystem_name = "musl"
  part_name = "libc-test"
  configs = [ "//third_party/musl/libc-test/src/common:config_runtest" ]

  include_dirs = [
    "//third_party/musl/libc-test/src/functionalext/common",
    "//third_party/musl/libc-test/src/common",
  ]

  sources = [ "prelink_dedup_test.c" ]

  # LIB_DIR first: "./" holds standalone nDSOs (hdc follows symlinks) whose
  # (dev, ino) mismatches and silently disables prelinking.
  ldflags = [ "-Wl,-rpath=/data/local/tmp/libc-test-lib/:./" ]
  deps = []
  data_deps = [
    ":prelink_dedup",
    ":prelink_dedup_a",
    ":prelink_dedup_b",
  ]
}

action("unittest_adlt_prelink_dedup_symlinks") {
  testonly = true
  deps = [
    ":prelink_dedup",
    ":prelink_dedup_a",
    ":prelink_dedup_b",
    ":unittest_adlt_prelink_dedup",
  ]

  script = "../adlt_tools.py"
  args = [
    "build_sym_links",
    "--lib-dir",
    rebase_path(adlt_lib_dir, ""),
    "--target-lib-dir",
    adlt_target_lib_dir,
    "--adlt-lib",
    "libadlt_prelink_dedup.so",
    "--orig-lib-list",
    "libadlt_prelink_dedup_a.so",
    "libadlt_prelink_dedup_b.so",
  ]

  outputs = [
    "$adlt_lib_dir/adlt_orig_libs/libadlt_prelink_dedup_a.so",
    "$adlt_lib_dir/adlt_orig_libs/libadlt_prelink_dedup_b.so",
  ]
}

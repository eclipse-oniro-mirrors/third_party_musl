import("../../../test_template.gni")

# The feature is compiled only for L2 extended builds, but the test runs in
# both forms to cover the always-exported no-op symbol. The OH Linux dynamic
# loader is not linked into the Cortex-M or riscv32 libc variants.
relative_path_loader_supported = is_standard_system &&
                                 musl_target_os == "linux" &&
                                 musl_arch != "cortex_m" &&
                                 musl_arch != "riscv32"

if (relative_path_loader_supported) {
  test_sharedlib("relative_path_fixture") {
  }

  # Concurrent and symbol cases stay in the source tree but are not registered
  # for now; only the matrix described in TEST_DESIGN.md is built.
  ohos_executable("dlopen_relative_path_matrix") {
    testonly = true
    subsystem_name = "musl"
    part_name = "libc-test"
    sources = [ "relative_path_test.c" ]
    defines = []
    if (musl_extended_function) {
      defines += [ "EXPECT_RELATIVE_PATH=1" ]
    } else {
      defines += [ "EXPECT_RELATIVE_PATH=0" ]
    }
    include_dirs = [
      "//${test_dir}/src/common",
      "//${musl_include_dir}",
    ]
    cflags_c = [
      "-std=c99",
      "-Wall",
      "-Wextra",
      "-Werror=implicit-function-declaration",
    ]
    ldflags = [ "-nostdlib" ]
    libs = [ "//${out_test_dir}/src/common/libtest.a" ]
    deps = [ ":relative_path_fixture" ]
  }
}

group("ldso_dlopen_relative_path_test") {
  testonly = true
  deps = []
  if (relative_path_loader_supported) {
    deps = [ ":dlopen_relative_path_matrix" ]
  }
}
